GAPGPT_API_KEY=your-gapgpt-api-key
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o-mini

AGENT_WORKSPACE=/absolute/path/to/your/project
AGENT_MAX_TOOL_ROUNDS=30
AGENT_MAX_HISTORY_TURNS=24
AGENT_COMMAND_TIMEOUT=120
AGENT_GREP_USE_RG=true
AGENT_IGNORE_DIRS=

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# اختیاری: محدود کردن مسیر پروژه‌ها (پیشوندها با کاما)
# AGENT_PROJECT_PATH_ALLOWLIST=/Users/you/projects,/home/you/code

# اختیاری: توکن برای API (هدر X-ACA-Token)
# AGENT_API_TOKEN=

# مدل جدا برای فاز thinking (پیشنهاد: مدل قوی‌تر روی gapgpt)
# GAPGPT_THINKING_MODEL=gpt-4o
# GAPGPT_FOCUS_MODEL=gpt-4o-mini
# AGENT_AUTO_FOCUS_MAX_PATHS=12
